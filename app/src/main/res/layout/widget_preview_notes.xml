<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="최근 메모     최근 수정순" android:textColor="#F4F5F7" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="최근 메모 3개" android:textColor="#F4F5F7" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical"
        android:text="▤ 쇼핑 · 다이소 살 것" android:textColor="#F4F5F7" android:textSize="13sp" />
    <TextView android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical"
        android:text="▤ 업무 · 확인할 내용" android:textColor="#F4F5F7" android:textSize="13sp" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom|end"
        android:text="○ ○ ○ ○ ● ○ ○" android:textColor="#9DA3AD" android:textSize="10sp" />
</LinearLayout>
